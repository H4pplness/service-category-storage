{
  "name": "dcms-knowledge",
  "version": "1.0.0",
  "private": true,
  "description": "Kho tri thức Sản phẩm - Nghiệp vụ đồng bộ từ Confluence, cung cấp MCP server cho Mindmate",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "sync": "tsx src/cli.ts sync",
    "sync:full": "tsx src/cli.ts sync --full",
    "search": "tsx src/cli.ts search",
    "mock:confluence": "tsx mock-confluence/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "seed:confluence": "tsx seed/seed-confluence.ts"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^4.22.3",
    "node-cron": "^4.6.0",
    "node-html-parser": "^9.0.4",
    "zod": "^4.6.5"
  }
}
