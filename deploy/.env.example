# Sao chép thành deploy/.env và điền giá trị thật (deploy/.env không được commit)

# ───── Kho tri thức: kết nối Confluence ─────
CONFLUENCE_TYPE=cloud
CONFLUENCE_BASE_URL=https://<site>.atlassian.net/wiki
CONFLUENCE_USERNAME=<email>
CONFLUENCE_TOKEN=<api-token>
CONFLUENCE_SPACES=DCMS

# Token Mindmate dùng khi gọi MCP kho tri thức (DCMS tự đăng ký vào Mindmate)
KNOWLEDGE_MCP_TOKEN=<chuỗi-ngẫu-nhiên>
# URL MCP nhìn từ mindmate-control-plane (chạy trên host)
KNOWLEDGE_MCP_URL=http://localhost:4100/mcp

# ───── DCMS ─────
JWT_SECRET=<chuỗi-ngẫu-nhiên>
MINDMATE_BASE_URL=http://localhost:8080
MINDMATE_TOKEN_URL=http://localhost:8081/realms/mindmate/protocol/openid-connect/token
MINDMATE_CLIENT_ID=dcms
MINDMATE_CLIENT_SECRET=<secret-client-dcms-trong-keycloak>
# MINDMATE_MODEL=deepseek-v4-pro
