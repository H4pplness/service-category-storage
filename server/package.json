{
  "name": "dcms-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "postinstall": "prisma generate",
    "db:reset": "node scripts/reset-db.cjs && npm run setup",
    "typecheck": "tsc --noEmit",
    "setup": "prisma db push --skip-generate && prisma generate && tsx prisma/seed.ts",
    "db:fill": "tsx prisma/fill-demo.ts",
    "mindmate:setup": "tsx scripts/mindmate-setup.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
